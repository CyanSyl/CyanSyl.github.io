---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import '../styles/global.css';

interface Props { title: string; description?: string; wide?: boolean }
const { title, description = '弈川的博客：记录学习，留住感想。', wide = false } = Astro.props;
// 首页 Hero 已有视频+星星+雾，面板只给内页
const isHome = Astro.url.pathname === '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pagefind 组件资源只有文章列表页用得到，其余页面不加载
const needsSearch = Astro.url.pathname.replace(/\/+$/, '') === '/blog';
---

<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="弈川的博客" />
        <meta property="og:image" content={new URL('/images/hero-poster.jpg', Astro.site)} />
        {needsSearch && <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />}
        {needsSearch && <script src="/pagefind/pagefind-component-ui.js" type="module"></script>}
        <title>{title}</title>
    </head>
    <body>
        {!isHome && <Starfield />}
        <Header />
        <main>
            {isHome ? <slot /> : (
                <div class:list={['panel', { wide }]}>
                    <slot />
                </div>
            )}
        </main>
        <Footer />
    </body>
</html>

<style>
    main {
        position: relative;
        z-index: 1;
        padding-top: 56px;
        animation: page-in 0.4s ease-out;
    }
    /* 内页中栏毛玻璃板：星空（底层）→ 板（柔化透光）→ 内容 */
    .panel {
        width: calc(100% - 2rem);
        max-width: calc(var(--max-width) + 2rem);
        margin: 1.5rem auto;
        padding: 0.5rem 1rem;
        background: rgba(12, 15, 28, 0.85);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid var(--color-border);
        border-radius: 12px;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    }
    /* 文章页带 TOC 时中栏更宽（720 正文 + 260 目录） */
    .panel.wide { max-width: calc(var(--max-width) + 260px + 2rem); }
    @media (max-width: 639px) {
        .panel { padding: 0.5rem 0; }
    }
    /* 窄屏导航折成两行时 header 变高，main 同步下移 */
    @media (max-width: 360px) {
        main { padding-top: 96px; }
    }
    @keyframes page-in {
        from { opacity: 0; transform: translateY(8px); }
    }
    @media (prefers-reduced-motion: reduce) {
        main { animation: none; }
    }
</style>

<script>
    // 滚动浮现：卡片、归档行进入视口时淡入上移
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion) {
        const els = document.querySelectorAll<HTMLElement>('.card, .entry');
        els.forEach((el, i) => {
            el.classList.add('reveal');
            el.style.transitionDelay = `${(i % 5) * 60}ms`;
        });
        const io = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                const el = entry.target as HTMLElement;
                el.classList.add('visible');
                io.unobserve(el);
                // 浮现结束后清掉延迟，避免影响 hover 过渡
                setTimeout(() => { el.style.transitionDelay = '0ms'; }, 600);
            });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => io.observe(el));
    }
</script>
