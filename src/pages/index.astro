---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  	.slice(0, 5);

const featuredProjects = projects.filter((p) => p.featured);
---
<BaseLayout title="首页 | 弈川">
  	<section class="hero">
    	<video class="bg-video" autoplay muted loop playsinline poster="/images/hero-poster.jpg">
      		<source src="/videos/hero.mp4" type="video/mp4" />
    	</video>
    	<div class="fog"></div>
    	<div class="stars stars-far"></div>
    	<div class="stars stars-near"></div>
    	<h1>记录学习，留住感想</h1>
    	<p class="hint">向下滚动 ↓</p>
  	</section>

  	<section class="recent">
    	<h2>最新文章</h2>
    	{recentPosts.map((post) => (
      		<PostCard
        		url={`/blog/${post.id}`}
        		title={post.data.title}
        		date={post.data.date}
        		description={post.data.description}
      		/>
    	))}
		<p class="more"><a href="/blog">全部文章 →</a></p>
  	</section>

  	<section class="featured">
    	<h2>精选项目</h2>
    	<div class="grid">
      		{featuredProjects.map((p) => (
        	<ProjectCard
          		name={p.name}
          		description={p.description}
          		techStack={p.techStack}
          		url={p.url}
        	/>
      		))}
    	</div>
    	<p class="more"><a href="/projects">全部项目 →</a></p>
  	</section>
</BaseLayout>

<style>
  	.hero {
    	position: relative;
    	margin-top: -56px;
    	height: 100vh;
    	overflow: hidden;
    	display: flex;
    	flex-direction: column;
    	justify-content: center;
    	align-items: center;
    	color: #fff;
    	text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  	}
  	.hero::before {
    	content: '';
    	position: absolute;
    	inset: 0;
    	background: url('/images/hero-poster.jpg') center / cover no-repeat;
    	z-index: 0;
  	}
  	.bg-video {
    	position: absolute;
    	inset: 0;
    	width: 100%;
    	height: 100%;
    	object-fit: cover;
    	z-index: 1;
  	}
  	.fog {
    	position: absolute;
    	inset: -10% -50%;
    	z-index: 1;
    	pointer-events: none;
    	background:
      		radial-gradient(ellipse 30% 20% at 20% 70%, rgba(255, 255, 255, 0.10), transparent 70%),
      		radial-gradient(ellipse 25% 15% at 60% 80%, rgba(200, 220, 255, 0.08), transparent 70%),
      		radial-gradient(ellipse 35% 18% at 85% 60%, rgba(255, 255, 255, 0.07), transparent 70%);
    	filter: blur(30px);
    	animation: wind 50s ease-in-out infinite alternate;
  	}
  	@keyframes wind {
    	from { transform: translateX(-4%); }
    	to { transform: translateX(4%); }
  	}
  	.stars {
    	position: absolute;
    	inset: -40px;
    	z-index: 1;
    	pointer-events: none;
  	}
  	.stars::before {
    	content: '';
    	position: absolute;
    	border-radius: 50%;
    	background: #fff;
    	filter: drop-shadow(0 0 4px rgba(255, 255, 255, 0.9));
  	}
  	.stars-far { transform: translate(calc(var(--px, 0px) * 0.4), calc(var(--py, 0px) * 0.4)); }
  	.stars-far::before {
    	width: 2px; height: 2px; opacity: 0.6;
    	box-shadow: 8vw 12vh #fff, 22vw 45vh #fff, 35vw 8vh #fff, 47vw 60vh #fff, 58vw 20vh #fff, 66vw 75vh #fff, 74vw 10vh #fff, 83vw 50vh #fff, 92vw 30vh #fff, 15vw 70vh #fff, 28vw 85vh #fff, 40vw 35vh #fff, 52vw 90vh #fff, 63vw 42vh #fff, 77vw 65vh #fff, 88vw 82vh #fff, 5vw 50vh #fff, 95vw 15vh #fff, 31vw 60vh #fff, 70vw 28vh #fff;
  	}
  	.stars-near { transform: translate(calc(var(--px, 0px) * 1.2), calc(var(--py, 0px) * 1.2)); }
  	.stars-near::before {
    	width: 3px; height: 3px; opacity: 0.95;
    	box-shadow: 12vw 25vh #fff, 30vw 55vh #fff, 45vw 15vh #fff, 60vw 70vh #fff, 72vw 38vh #fff, 85vw 60vh #fff, 20vw 80vh #fff, 50vw 78vh #fff, 90vw 45vh #fff, 8vw 60vh #fff, 38vw 88vh #fff, 68vw 85vh #fff;
  	}
  	.hero h1 { font-size: 2.5rem; }
  	.hint { margin-top: 2rem; opacity: 0.85; }
  	.hero::after {
    	content: '';
    	position: absolute;
    	left: 0; right: 0; bottom: 0;
    	height: 30%;
    	background: linear-gradient(to bottom, transparent, var(--color-bg));
    	pointer-events: none;
    	z-index: 2;
  	}
  	.hero h1, .hero .hint {
    	position: relative;
    	z-index: 3;
    	transform: translate(calc(var(--px, 0px) * 0.7), calc(var(--py, 0px) * 0.7));
    	animation: rise 0.9s ease-out both;
  	}
  	.hero .hint { animation-delay: 0.35s; }
  	@keyframes rise {
    	from { opacity: 0; transform: translateY(24px); }
  	}
  	@media (prefers-reduced-motion: reduce) {
    	.fog { animation: none; }
    	.bg-video { display: none; }
    	.hero h1, .hero .hint { animation: none; }
  	}
  	.recent, .featured {
    	max-width: var(--max-width);
    	margin: 0 auto;
    	padding: 3rem 1rem 0;
  	}
  	.grid {
    	display: grid;
    	grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    	gap: 1rem;
    	margin-top: 1rem;
  	}
  	.more { margin: 1rem 0 3rem; }
</style>

<script>
  	const hero = document.querySelector<HTMLElement>('.hero');
  	// 只在有鼠标的设备上启用（pointer: fine = 精确指针，触屏为 coarse）
  	// 用户系统设置了"减少动态效果"时尊重其偏好
  	const ok = window.matchMedia('(pointer: fine)').matches
    	&& !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  	if (hero && ok) {
    	const MAX = 15; // 最大偏移像素
    	let targetX = 0, targetY = 0, curX = 0, curY = 0;

    	window.addEventListener('mousemove', (e) => {
      		// 鼠标位置归一化到 -1 ~ 1
      		targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      		targetY = (e.clientY / window.innerHeight - 0.5) * 2;
    	});

    	const tick = () => {
      		// 缓动：每帧向目标靠近 6%，形成平滑跟随
      		curX += (targetX - curX) * 0.06;
      		curY += (targetY - curY) * 0.06;
      		hero.style.setProperty('--px', `${-curX * MAX}px`);
      		hero.style.setProperty('--py', `${-curY * MAX}px`);
      		requestAnimationFrame(tick);
    	};
    	tick();
  	}
</script>