---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  	.slice(0, 5);

const featuredProjects = projects.filter((p) => p.featured);
---
<BaseLayout title="首页 | 我的博客">
  	<section class="hero">
    	<h1>一句话标语写在这里</h1>
    	<p class="hint">向下滚动 ↓</p>
  	</section>

  	<section class="recent">
    	<h2>最新文章</h2>
    	{recentPosts.map((post) => (
      		<PostCard
        		url={`/blog/${post.id}`}
        		title={post.data.title}
        		date={post.data.date}
        		description={post.data.description}
      		/>
    	))}
		<p class="more"><a href="/blog">全部文章 →</a></p>
  	</section>

  	<section class="featured">
    	<h2>精选项目</h2>
    	<div class="grid">
      		{featuredProjects.map((p) => (
        	<ProjectCard
          		name={p.name}
          		description={p.description}
          		techStack={p.techStack}
          		url={p.url}
        	/>
      		))}
    	</div>
    	<p class="more"><a href="/projects">全部项目 →</a></p>
  	</section>
</BaseLayout>

<style>
  	.hero {
    	position: relative;
    	margin-top: -56px;
    	height: 100vh;
    	overflow: hidden;
    	display: flex;
    	flex-direction: column;
    	justify-content: center;
    	align-items: center;
    	color: #fff;
    	text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
  	}
  	.hero::before {
    	content: '';
    	position: absolute;
    	inset: -30px;
    	background: url('/images/hero2.png') center / cover no-repeat;
    	transform: translate(var(--px, 0px), var(--py, 0px));
    	z-index: 0;
  	}
  	.hero h1 { font-size: 2.5rem; }
  	.hint { margin-top: 2rem; opacity: 0.85; }
  	.hero::after {
    	content: '';
    	position: absolute;
    	left: 0; right: 0; bottom: 0;
    	height: 30%;
    	background: linear-gradient(to bottom, transparent, var(--color-bg));
    	pointer-events: none;
    	z-index: 1;
  	}
  	.hero h1, .hero .hint { position: relative; z-index: 2; }
  	.recent, .featured {
    	max-width: var(--max-width);
    	margin: 0 auto;
    	padding: 3rem 1rem 0;
  	}
  	.grid {
    	display: grid;
    	grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    	gap: 1rem;
    	margin-top: 1rem;
  	}
  	.more { margin: 1rem 0 3rem; }
</style>

<script>
  	const hero = document.querySelector('.hero');
  	// 只在有鼠标的设备上启用（pointer: fine = 精确指针，触屏为 coarse）
  	if (hero && window.matchMedia('(pointer: fine)').matches) {
    	const MAX = 20; // 最大偏移像素
    	let targetX = 0, targetY = 0, curX = 0, curY = 0;

    	window.addEventListener('mousemove', (e) => {
      		// 鼠标位置归一化到 -1 ~ 1
      		targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      		targetY = (e.clientY / window.innerHeight - 0.5) * 2;
    	});

    	const tick = () => {
      		// 缓动：每帧向目标靠近 6%，形成平滑跟随
      		curX += (targetX - curX) * 0.06;
      		curY += (targetY - curY) * 0.06;
      		hero.style.setProperty('--px', `${-curX * MAX}px`);
      		hero.style.setProperty('--py', `${-curY * MAX}px`);
      		requestAnimationFrame(tick);
    	};
    	tick();
  	}
</script>