---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="关于我 | 我的博客">
    <section class="about">
        <h1>关于我</h1>
        <p>（自我介绍：你是谁、在学什么、为什么写博客。）</p>
        <h2>技能</h2>
        <p>（如：后端开发基础、正在学习前端。）</p>
        <h2>联系我</h2>
        <p>（GitHub / 邮箱等。）</p>
    </section>
</BaseLayout>

<style>
    .about { max-width: var(--max-width); margin: 0 auto; padding: 2rem 1rem; }
    h2 { margin-top: 2rem; }
    p { margin: 0.5rem 0; }
</style>