---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // posts 按日期倒序：i-1 是更新的，i+1 是更早的
      prev: posts[i - 1] ?? null,
      next: posts[i + 1] ?? null,
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);

// 字数统计：去掉代码块和 Markdown 符号后，中文字符 + 英文单词
const plain = (post.body ?? '')
  .replace(/```[\s\S]*?```/g, '')
  .replace(/[#>*`\-[\]()!|]/g, '');
const cjk = (plain.match(/[一-鿿]/g) ?? []).length;
const words = (plain.replace(/[一-鿿]/g, ' ').match(/[a-zA-Z0-9]+/g) ?? []).length;
const wordCount = cjk + words;
// 中文阅读速度约 400 字/分钟
const readingTime = Math.max(1, Math.round(wordCount / 400));
---
<BlogPost
  title={post.data.title}
  date={post.data.date}
  updated={post.data.updated}
  tags={post.data.tags}
  headings={headings}
  prev={prev}
  next={next}
  wordCount={wordCount}
  readingTime={readingTime}
  description={post.data.description || undefined}
>
  <Content />
</BlogPost>
