<canvas id="starfield" aria-hidden="true"></canvas>

<style>
    #starfield {
        position: fixed;
        inset: 0;
        z-index: 0;
        pointer-events: none;
        /* 夜空底色：天顶近黑且深色区延伸，地平线处泛蓝紫，叠加两片星云雾 */
        background:
            radial-gradient(ellipse 60% 40% at 70% 18%, rgba(90, 110, 180, 0.13), transparent 70%),
            radial-gradient(ellipse 50% 35% at 22% 68%, rgba(130, 90, 160, 0.09), transparent 70%),
            linear-gradient(to bottom, #020408 0%, #070c1a 40%, #10162e 100%);
    }
</style>

<script>
    // 内页背景：渐变夜空 + 月亮 + 微闪星空 + 偶发流星
    // 想调节强度改下面三个常量即可
    const STAR_COUNT = 120;      // 星星数量
    const METEOR_MIN_GAP = 1200; // 流星最小间隔（毫秒）
    const METEOR_MAX_GAP = 3500; // 流星最大间隔（毫秒）

    const canvas = document.getElementById('starfield') as HTMLCanvasElement | null;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canvas) {
        const ctx = canvas.getContext('2d')!;
        let w = 0, h = 0, dpr = 1;
        const resize = () => {
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            w = canvas.width = window.innerWidth * dpr;
            h = canvas.height = window.innerHeight * dpr;
        };
        resize();
        window.addEventListener('resize', resize);

        // 位置用 0~1 的比例存，窗口缩放后仍在相对位置
        const stars = Array.from({ length: STAR_COUNT }, () => ({
            x: Math.random(),
            y: Math.random(),
            r: 0.4 + Math.random() * 1.3,       // 半径（CSS 像素），大小拉开差距
            base: 0.15 + Math.random() * 0.3,    // 基础亮度
            amp: 0.1 + Math.random() * 0.2,      // 明灭幅度
            speed: 0.3 + Math.random() * 0.8,    // 明灭速度
            phase: Math.random() * Math.PI * 2,  // 初始相位（错开闪烁节奏）
            // 少量暖色星，其余冷白/淡蓝
            color: Math.random() < 0.12 ? '#ffe9c8'
                : Math.random() < 0.5 ? '#cdd6f4' : '#ffffff',
        }));

        const drawStars = (t: number) => {
            for (const s of stars) {
                const alpha = Math.max(s.base + Math.sin(t * s.speed + s.phase) * s.amp, 0);
                ctx.globalAlpha = alpha;
                ctx.fillStyle = s.color;
                ctx.beginPath();
                ctx.arc(s.x * w, s.y * h, s.r * dpr, 0, Math.PI * 2);
                ctx.fill();
            }
            ctx.globalAlpha = 1;
        };

        // 右上角的月亮：光晕 + 月盘（位置要避开中栏面板，否则会被毛玻璃盖住）
        const drawMoon = () => {
            const mx = w * 0.93, my = h * 0.11, mr = 24 * dpr;
            const glow = ctx.createRadialGradient(mx, my, mr * 0.5, mx, my, mr * 4);
            glow.addColorStop(0, 'rgba(240, 230, 200, 0.18)');
            glow.addColorStop(1, 'rgba(240, 230, 200, 0)');
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(mx, my, mr * 4, 0, Math.PI * 2);
            ctx.fill();
            // 月盘：左上稍亮的径向渐变，模拟明暗面
            const disc = ctx.createRadialGradient(
                mx - mr * 0.3, my - mr * 0.3, mr * 0.1, mx, my, mr
            );
            disc.addColorStop(0, '#f7f0dd');
            disc.addColorStop(1, '#d8cdb2');
            ctx.fillStyle = disc;
            ctx.beginPath();
            ctx.arc(mx, my, mr, 0, Math.PI * 2);
            ctx.fill();
        };

        if (reduceMotion) {
            // 用户系统开了"减少动态效果"：只画一帧静态夜空，没有闪烁和流星
            drawStars(0);
            drawMoon();
        } else {
            interface Meteor {
                x: number; y: number;
                vx: number; vy: number;
                born: number; life: number;
            }
            let meteors: Meteor[] = [];
            let nextSpawn = performance.now() + 1000;
            let last = performance.now();
            let raf = 0;

            const frame = (now: number) => {
                const dt = Math.min((now - last) / 1000, 0.05);
                last = now;
                ctx.clearRect(0, 0, w, h);
                drawStars(now / 1000);
                drawMoon();

                if (now >= nextSpawn) {
                    // 方向随机：一半向左下（135°~160°），一半向右下（20°~45°）
                    const toLeft = Math.random() < 0.5;
                    const angle = toLeft
                        ? Math.PI * (0.72 + Math.random() * 0.12)
                        : Math.PI * (0.16 + Math.random() * 0.12);
                    const speed = (500 + Math.random() * 400) * dpr;
                    meteors.push({
                        x: w * (0.05 + Math.random() * 0.9),
                        y: h * Math.random() * 0.4,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        born: now,
                        life: 0.8 + Math.random() * 0.5,
                    });
                    nextSpawn = now + METEOR_MIN_GAP + Math.random() * (METEOR_MAX_GAP - METEOR_MIN_GAP);
                }

                meteors = meteors.filter((m) => now - m.born < m.life * 1000);
                for (const m of meteors) {
                    m.x += m.vx * dt;
                    m.y += m.vy * dt;
                    const fade = 1 - (now - m.born) / 1000 / m.life;
                    const len = Math.hypot(m.vx, m.vy);
                    // 尾迹 = 沿速度反方向拉一条渐隐的线
                    const tx = m.x - (m.vx / len) * 100 * dpr;
                    const ty = m.y - (m.vy / len) * 100 * dpr;
                    const grad = ctx.createLinearGradient(m.x, m.y, tx, ty);
                    grad.addColorStop(0, `rgba(230, 233, 240, ${0.75 * fade})`);
                    grad.addColorStop(1, 'rgba(230, 233, 240, 0)');
                    ctx.strokeStyle = grad;
                    ctx.lineWidth = 1.4 * dpr;
                    ctx.beginPath();
                    ctx.moveTo(m.x, m.y);
                    ctx.lineTo(tx, ty);
                    ctx.stroke();
                }
                raf = requestAnimationFrame(frame);
            };
            raf = requestAnimationFrame(frame);

            // 标签页切走时暂停，回来再继续
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    cancelAnimationFrame(raf);
                } else {
                    last = performance.now();
                    raf = requestAnimationFrame(frame);
                }
            });
        }
    }
</script>
